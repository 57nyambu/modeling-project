# Production settings for the Django API. Copy to api/.env on the server and fill in.
# api/.env is ignored by git; keep it readable by your user only: chmod 600 api/.env
#
# Make the key with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (letters, digits, - and _ only, so it is safe in shell-loaded env files)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=supermarket.virontech.me,localhost,127.0.0.1
